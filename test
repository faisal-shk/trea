                        <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 flex items-center" onclick="openModal('add-product-modal')">
                            <i class="fas fa-plus mr-2"></i> Add Product
                        </button>
                    </div>
                    
