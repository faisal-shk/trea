<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockMaster - Inventory Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-gray-50">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <div class="sidebar bg-indigo-700 text-white w-64 flex flex-col">
            <div class="p-4 flex items-center justify-between border-b border-indigo-600">
                <div class="flex items-center space-x-2">
                    <i class="fas fa-boxes text-2xl"></i>
                    <span class="logo-text text-xl font-bold">StockMaster</span>
                </div>
                <button id="toggle-sidebar" class="expand-icon text-white focus:outline-none transition-transform">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>
            
            <div class="flex-1 overflow-y-auto py-4">
                <nav>
                    <div class="px-4 space-y-2">
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="dashboard">
                            <i class="fas fa-tachometer-alt"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="products">
                            <i class="fas fa-box-open"></i>
                            <span class="nav-text">Products</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="inventory">
                            <i class="fas fa-warehouse"></i>
                            <span class="nav-text">Inventory</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="suppliers">
                            <i class="fas fa-truck"></i>
                            <span class="nav-text">Suppliers</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="orders">
                            <i class="fas fa-file-invoice-dollar"></i>
                            <span class="nav-text">Orders</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="reports">
                            <i class="fas fa-chart-line"></i>
                            <span class="nav-text">Reports</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="users">
                            <i class="fas fa-users"></i>
                            <span class="nav-text">Users</span>
                        </a>
                        <a href="#" class="nav-link flex items-center space-x-3 px-3 py-2 rounded-lg" data-page="settings">
                            <i class="fas fa-cog"></i>
                            <span class="nav-text">Settings</span>
                        </a>
                    </div>
                </nav>
            </div>
            
            <div class="p-4 border-t border-indigo-600">
                <div class="flex items-center space-x-3">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=random" alt="User" class="w-10 h-10 rounded-full">
                    <div class="nav-text">
                        <div class="font-medium">Admin User</div>
                        <div class="text-xs text-indigo-200">admin@example.com</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="flex-1 overflow-auto">
            <!-- Top Navigation -->
            <header class="bg-white shadow-sm">
                <div class="flex items-center justify-between px-6 py-4">
